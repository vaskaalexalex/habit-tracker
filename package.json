{
  "name": "habit-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "predev": "node scripts/write-build-id.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/write-build-id.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:offline-browser": "node scripts/run-offline-browser-test.mjs",
    "test:pwa-offline": "node scripts/run-pwa-offline-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.7.0",
    "@vite-pwa/sveltekit": "^1.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.11.0",
    "playwright": "1.49.1",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.5",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@supabase/supabase-js": "^2.46.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "layerchart": "^1.0.0",
    "lucide-svelte": "^0.460.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
