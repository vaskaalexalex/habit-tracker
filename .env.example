PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web Push (VAPID public key only in the browser bundle; private key lives in Edge secrets)
PUBLIC_VAPID_PUBLIC_KEY=

# Edge Function `send-habit-reminders` secrets (set in Supabase Dashboard, not in .env for prod):
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT=mailto:you@example.com
# Optional: CRON_SECRET — if set, invoke with header Authorization: Bearer <CRON_SECRET>
